{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v3.0.0/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Mini-VLAT Annotation Study",
    "version": "development",
    "authors": [
      "Annotation Probe"
    ],
    "organizations": [
      "Annotation Probe"
    ],
    "date": "2026-11-11",
    "description": "The 12 Mini-VLAT items (Pandey & Ottley, 2023) with multiple-choice answers and pointer annotation. Each item is preceded by a fixation-cross pupil baseline and followed by a NASA-TLX."
  },
  "uiConfig": {
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "contactEmail": "study-contact@example.org",
    "withProgressBar": true,
    "withSidebar": true,
    "autoDownloadStudy": true,
    "autoDownloadTime": 5000,
    "stylesheetPath": "annotation-probe/study.css",
    "nextButtonLocation": "sidebar"
  },
  "baseComponents": {
    "fixation": {
      "type": "react-component",
      "path": "annotation-probe/FixationBaseline.tsx",
      "description": "Fixation-cross pupil baseline on neutral grey; auto-advances after durationMs.",
      "style": {
        "maxWidth": "100%",
        "maxHeight": "70vh"
      },
      "response": [
        {
          "id": "baseline",
          "type": "reactive",
          "prompt": "Fixation baseline",
          "location": "sidebar",
          "hidden": true,
          "required": true
        }
      ],
      "stylesheetPath": "annotation-probe/fixation.css",
      "parameters": {
        "durationMs": 5000
      }
    },
    "graph": {
      "type": "react-component",
      "path": "annotation-probe/AnnotationTrial.tsx",
      "style": {
        "maxWidth": "100%",
        "maxHeight": "70vh"
      },
      "response": [
        {
          "id": "answer",
          "type": "radio",
          "prompt": "Your answer",
          "location": "sidebar",
          "required": true,
          "options": []
        },
        {
          "id": "annotation",
          "type": "reactive",
          "prompt": "Drawing annotations",
          "location": "sidebar",
          "hidden": true,
          "required": false
        }
      ],
      "instructionLocation": "sidebar",
      "description": "Mini-VLAT item with pointer annotation; per-item question, options, and answer key come from the component."
    },
    "nasa-tlx": {
      "type": "questionnaire",
      "description": "NASA Task Load Index (raw TLX, 0-100 in steps of 5).",
      "instruction": "Rate the graph task you just completed on each scale.",
      "instructionLocation": "aboveStimulus",
      "withSidebar": false,
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "mental-demand",
          "type": "slider",
          "prompt": "Mental Demand: How mentally demanding was the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Very Low",
              "value": 0
            },
            {
              "label": "Very High",
              "value": 100
            }
          ]
        },
        {
          "id": "physical-demand",
          "type": "slider",
          "prompt": "Physical Demand: How physically demanding was the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Very Low",
              "value": 0
            },
            {
              "label": "Very High",
              "value": 100
            }
          ]
        },
        {
          "id": "temporal-demand",
          "type": "slider",
          "prompt": "Temporal Demand: How hurried or rushed was the pace of the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Very Low",
              "value": 0
            },
            {
              "label": "Very High",
              "value": 100
            }
          ]
        },
        {
          "id": "performance",
          "type": "slider",
          "prompt": "Performance: How successful were you in accomplishing what you were asked to do?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Perfect",
              "value": 0
            },
            {
              "label": "Failure",
              "value": 100
            }
          ]
        },
        {
          "id": "effort",
          "type": "slider",
          "prompt": "Effort: How hard did you have to work to accomplish your level of performance?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Very Low",
              "value": 0
            },
            {
              "label": "Very High",
              "value": 100
            }
          ]
        },
        {
          "id": "frustration",
          "type": "slider",
          "prompt": "Frustration: How insecure, discouraged, irritated, stressed, and annoyed were you?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Very Low",
              "value": 0
            },
            {
              "label": "Very High",
              "value": 100
            }
          ]
        }
      ]
    }
  },
