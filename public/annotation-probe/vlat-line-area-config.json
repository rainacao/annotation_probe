{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v3.0.0/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "VLAT Line and Area Annotation Study",
    "version": "development",
    "authors": [
      "Annotation Probe"
    ],
    "organizations": [
      "Annotation Probe"
    ],
    "date": "2026-11-15",
    "description": "15 items from the reVISit vlat library (sequence 'full', chart types line, area, stackarea) with multiple-choice answers and drawing. Generated by scripts/import_library_items.py. S. Lee, S.-H. Kim, and B. C. Kwon, \u201cVLAT: Development of a Visualization Literacy Assessment Test,\u201d IEEE Transactions on Visualization and Computer Graphics, vol. 23, no. 1, pp. 551\u2013560, Jan. 2017."
  },
  "uiConfig": {
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "contactEmail": "study-contact@example.org",
    "withProgressBar": true,
    "withSidebar": true,
    "autoDownloadStudy": true,
    "autoDownloadTime": 5000,
    "stylesheetPath": "annotation-probe/study.css",
    "nextButtonLocation": "sidebar"
  },
  "baseComponents": {
    "fixation": {
      "type": "react-component",
      "path": "annotation-probe/FixationBaseline.tsx",
      "description": "Fixation-cross pupil baseline on neutral grey; auto-advances after durationMs.",
      "style": {
        "maxWidth": "100%",
        "maxHeight": "70vh"
      },
      "response": [
        {
          "id": "baseline",
          "type": "reactive",
          "prompt": "Fixation baseline",
          "location": "sidebar",
          "hidden": true,
          "required": true
        }
      ],
      "stylesheetPath": "annotation-probe/fixation.css",
      "parameters": {
        "durationMs": 5000
      }
    },
    "graph": {
      "type": "react-component",
      "path": "annotation-probe/ExcalidrawTrial.tsx",
      "style": {
        "maxWidth": "100%",
        "maxHeight": "70vh"
      },
      "response": [
        {
          "id": "answer",
          "type": "radio",
          "prompt": "",
          "location": "sidebar",
          "required": true,
          "options": []
        },
        {
          "id": "drawing",
          "type": "reactive",
          "prompt": "Drawing scene",
          "location": "sidebar",
          "hidden": true,
          "required": false
        }
      ],
      "description": "Mini-VLAT item with an Excalidraw drawing layer over the graph; per-item question, options, and answer key come from the component. To use the pointer event log instead, set path to annotation-probe/AnnotationTrial.tsx and the reactive response id to annotationEvents."
    },
    "nasa-tlx": {
      "type": "questionnaire",
      "description": "NASA Task Load Index (raw TLX, 0-100 in steps of 5).",
      "instruction": "Rate the graph task you just completed on each scale.",
      "instructionLocation": "aboveStimulus",
      "withSidebar": false,
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "mental-demand",
          "type": "slider",
          "prompt": "Mental Demand: How mentally demanding was the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Low",
              "value": 0
            },
            {
              "label": "High",
              "value": 100
            }
          ],
          "default": 0
        },
        {
          "id": "physical-demand",
          "type": "slider",
          "prompt": "Physical Demand: How physically demanding was the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Low",
              "value": 0
            },
            {
              "label": "High",
              "value": 100
            }
          ],
          "default": 0
        },
        {
          "id": "temporal-demand",
          "type": "slider",
          "prompt": "Temporal Demand: How hurried or rushed was the pace of the task?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Low",
              "value": 0
            },
            {
              "label": "High",
              "value": 100
            }
          ],
          "default": 0
        },
        {
          "id": "performance",
          "type": "slider",
          "prompt": "Performance: How successful were you in accomplishing what you were asked to do?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Good",
              "value": 0
            },
            {
              "label": "Poor",
              "value": 100
            }
          ],
          "default": 0
        },
        {
          "id": "effort",
          "type": "slider",
          "prompt": "Effort: How hard did you have to work to accomplish your level of performance?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Low",
              "value": 0
            },
            {
              "label": "High",
              "value": 100
            }
          ],
          "default": 0
        },
        {
          "id": "frustration",
          "type": "slider",
          "prompt": "Frustration: How insecure, discouraged, irritated, stressed, and annoyed were you?",
          "location": "belowStimulus",
          "required": true,
          "tlxStyle": true,
          "step": 5,
          "spacing": 5,
          "options": [
            {
              "label": "Low",
              "value": 0
            },
            {
              "label": "High",
              "value": 100
            }
          ],
          "default": 0
        }
      ]
    }
  },
