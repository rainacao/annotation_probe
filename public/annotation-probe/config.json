{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v3.0.0/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "VLAT Graph Viewing Study",
    "version": "development",
    "authors": [
      "Annotation Probe"
    ],
    "organizations": [
      "Annotation Probe"
    ],
    "date": "2026-11-11",
    "description": "View a fixed sequence of VLAT graph images and record one response for each graph."
  },
  "uiConfig": {
    "logoPath": "revisitAssets/revisitLogoSquare.svg",
    "contactEmail": "study-contact@example.org",
    "withProgressBar": true,
    "withSidebar": true,
    "autoDownloadStudy": true,
    "autoDownloadTime": 5000
  },
  "components": {
    "graph-01": {
      "type": "react-component",
      "path": "annotation-probe/AnnotationTrial.tsx",
      "parameters": {
        "imageUrl": "https://raw.githubusercontent.com/revisit-studies/library-assets/v1/vlat/VLAT1.png"
      },
      "style": {
        "maxWidth": "100%",
        "maxHeight": "70vh"
      },
      "response": [
        {
          "id": "annotation",
          "type": "reactive",
          "prompt": "Drawing annotations",
          "location": "sidebar",
          "hidden": true,
          "required": false
        },
        {
          "id": "answer",
          "type": "shortText",
          "prompt": "What is your answer for this graph?",
          "placeholder": "Enter your answer",
          "location": "sidebar",
          "required": true
        }
      ]
